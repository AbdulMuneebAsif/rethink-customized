<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Label at the top left corner -->
    <TextView
        android:id="@+id/app_count_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="299 Apps"
        android:textSize="18sp"
        android:layout_gravity="start" />

    <!-- Text views to show dynamic values -->
    <TextView
        android:id="@+id/total_apps_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total Packages Scanned: 0"
        android:textSize="18sp"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/threat_count_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total Threats Found: 0"
        android:textSize="18sp"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/current_app_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Currently Scanning: None"
        android:textSize="18sp"
        android:layout_marginTop="8dp" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <!-- ProgressBar centered on the screen with larger size -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:visibility="gone"
            android:layout_centerInParent="true" />
    </RelativeLayout>

    <!-- Buttons for Quick Scan and Deep Scan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/quick_scan_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick Scan"
            android:layout_margin="8dp" />

        <Button
            android:id="@+id/deep_scan_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Deep Scan"
            android:layout_margin="8dp" />
    </LinearLayout>

</LinearLayout>